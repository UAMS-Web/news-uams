{
    "name": "uams-web/news-uams",
    "description": "Child theme for UAMS News (development-only Composer file; the theme ships no Composer dependencies).",
    "type": "wordpress-theme",
    "license": "proprietary",
    "require": {
        "php": ">=8.2"
    },
    "config": {
        "platform": {
            "php": "8.4.27"
        },
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "require-dev": {
        "brain/monkey": "^2.7",
        "pestphp/pest": "^5.3"
    },
    "scripts": {
        "test": [
            "@test:unit"
        ],
        "test:unit": "pest"
    },
    "scripts-descriptions": {
        "test": "Run the Pest unit suite.",
        "test:unit": "Run the Pest suite that needs no WordPress and no database."
    }
}
